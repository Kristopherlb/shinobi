**/cdk.context.json

# Baseline captures (large, should not be indexed)
baselines
baseline-*/
**/baselines/

# NX cache
.nx

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
**/*.log

# Environment files
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
.cursor/skills
**/.cursor/skills

# Generated files
**/*-template.json
**/*-dev-template.json
**/*-prod-template.json

# Test artifacts
apps/test-service/
apps/test-ec2/
