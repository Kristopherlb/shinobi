#!/usr/bin/env bash
# Shinobi MCP Server Configuration Helper
# This script helps developers configure Cursor to use the Shinobi MCP server

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
MCP_LAUNCHER="$PROJECT_ROOT/bin/shinobi-mcp"
CURSOR_CONFIG="$HOME/.cursor/mcp.json"

echo "🥷 Shinobi MCP Server Configuration"
echo "=================================="
echo ""

# Check if MCP server is built
if [ ! -f "$PROJECT_ROOT/apps/shinobi-mcp-server/dist/index.js" ]; then
    echo "❌ MCP server not built yet."
    echo ""
    read -p "Build it now? (y/n) " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        cd "$PROJECT_ROOT"
        pnpm mcp:build
    else
        echo "Please run 'pnpm mcp:build' first."
        exit 1
    fi
fi

echo "✅ MCP server is built"
echo ""

# Show the configuration that needs to be added
echo "Configuration to add to $CURSOR_CONFIG:"
echo ""
cat <<EOF
{
  "mcpServers": {
    "shinobi": {
      "command": "$MCP_LAUNCHER",
      "env": {
        "NODE_ENV": "development"
      }
    }
  }
}
EOF
echo ""

# Offer to update the config
if [ -f "$CURSOR_CONFIG" ]; then
    echo "⚠️  Cursor MCP config already exists at $CURSOR_CONFIG"
    echo ""
    read -p "Backup and update it automatically? (y/n) " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        # Backup existing config
        cp "$CURSOR_CONFIG" "$CURSOR_CONFIG.backup.$(date +%Y%m%d_%H%M%S)"
        echo "✅ Backed up existing config"
        
        # Check if shinobi is already configured
        if grep -q '"shinobi"' "$CURSOR_CONFIG" 2>/dev/null; then
            echo "⚠️  'shinobi' entry already exists in config"
            echo "Updating it..."
            # Use a temp file to update the config
            # This is a simple approach - production would need more robust JSON manipulation
            echo "Manual update recommended - see template above"
        else
            echo "Adding shinobi configuration..."
            # Simple approach: this assumes basic JSON structure
            # Production would use jq or similar
            echo "Manual update recommended - see template above"
        fi
    fi
else
    echo "📝 No existing Cursor MCP config found."
    echo ""
    read -p "Create it now? (y/n) " -n 1 -r
    echo ""
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        mkdir -p "$(dirname "$CURSOR_CONFIG")"
        cat > "$CURSOR_CONFIG" <<EOF
{
  "mcpServers": {
    "shinobi": {
      "command": "$MCP_LAUNCHER",
      "env": {
        "NODE_ENV": "development"
      }
    }
  }
}
EOF
        echo "✅ Created $CURSOR_CONFIG"
    fi
fi

echo ""
echo "=================================="
echo "Next steps:"
echo "1. ✅ Verify config at: $CURSOR_CONFIG"
echo "2. 🔄 Restart Cursor completely"
echo "3. ✅ Test: './bin/shinobi-mcp' should start without errors"
echo ""
echo "Your MCP launcher path: $MCP_LAUNCHER"


