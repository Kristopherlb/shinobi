#!/usr/bin/env bash
# Shinobi MCP Server via Docker - Stdio Mode
# Portable: runs container once, each invocation connects via stdin/stdout

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
CONTAINER_NAME="shinobi-mcp-stdio"
IMAGE_NAME="shinobi-mcp-server:latest"

# Build image if needed
if ! docker images --format '{{.Repository}}:{{.Tag}}' | grep -q "^$IMAGE_NAME\$"; then
    docker build -t "$IMAGE_NAME" \
        -f "$PROJECT_ROOT/apps/shinobi-mcp-server/Dockerfile" \
        "$PROJECT_ROOT" >&2
fi

# Run the MCP server directly (no background container needed)
# Docker will handle stdio properly
exec docker run --rm -i \
    -e NODE_ENV=development \
    -e MCP_TRANSPORT=stdio \
    -v "$PROJECT_ROOT/platform-kb:/app/platform-kb:ro" \
    -v "$PROJECT_ROOT/packages/components:/app/packages/components:ro" \
    "$IMAGE_NAME"
