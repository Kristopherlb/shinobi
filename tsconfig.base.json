{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "downlevelIteration": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "preserveSymlinks": false,
    "baseUrl": "."
  },
  "exclude": [
    "dist",
    "node_modules",
    "packages/core/_temp-problematic-files/**",
    "packages/core/_temp-problematic-platform/**",
    "**/vitest.config.ts",
    "**/jest.config.ts"
  ]
}
