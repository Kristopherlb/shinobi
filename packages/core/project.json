{
  "name": "@shinobi/core",
  "root": "packages/core",
  "sourceRoot": "packages/core/src",
  "projectType": "library",
  "implicitDependencies": [
  ],
  "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc --build packages/core/tsconfig.lib.json"
        },
      "inputs": [
        "default",
        "{projectRoot}/tsconfig.lib.json",
        "{projectRoot}/src/**"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p packages/core/tsconfig.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "options": {
        "jestConfig": "packages/core/jest.config.mjs",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --ext .ts,.tsx"
      }
    }
  },
  "tags": [
    "scope:shinobi",
    "type:core"
  ]
}
