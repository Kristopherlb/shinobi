{
  "name": "@shinobi/skill-<%= skillName %>",
  "sourceRoot": ".cursor/skills/<%= skillName %>",
  "targets": {
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "passWithNoTests": true,
        "config": ".cursor/skills/<%= skillName %>/vitest.config.ts"
      },
      "outputs": [
        "{projectRoot}/coverage"
      ]
    },
    "validate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx test @shinobi/skill-<%= skillName %>",
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": [
    "scope:shinobi",
    "type:skill"
  ]
}

