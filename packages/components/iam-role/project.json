{
  "name": "@shinobi/components-iam-role",
  "sourceRoot": "packages/components/iam-role/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node_modules/.bin/tsc -b packages/components/iam-role/tsconfig.build.json",
        "cwd": "{workspaceRoot}"
      },
      "outputs": [
        "{workspaceRoot}/dist/packages/components/iam-role"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/components/iam-role/tsconfig.json --noEmit",
        "cwd": "{workspaceRoot}"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rimraf dist/packages/components/iam-role",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "options": {
        "config": "packages/components/iam-role/vitest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --ext .ts,.tsx",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": [
    "scope:shinobi",
    "type:component",
    "infra:aws"
  ]
}
