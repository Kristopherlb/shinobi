{
  "name": "@shinobi/components-container-application",
  "sourceRoot": "packages/components/container-application/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc -b packages/components/container-application/tsconfig.build.json"
      },
      "outputs": [
        "{workspaceRoot}/dist/packages/components/container-application"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/components/container-application/tsconfig.json --noEmit"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rimraf dist/packages/components/container-application"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "options": {
        "jestConfig": "packages/components/container-application/jest.config.mjs",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --ext .ts,.tsx"
      }
    }
  },
  "tags": [
    "scope:shinobi",
    "type:component",
    "infra:aws"
  ]
}