{
  "name": "@shinobi/component-elasticache-redis",
  "version": "1.0.0",
  "description": "Managed Redis cluster with encryption, subnet groups, and monitoring baselines",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "Config.schema.json",
    "README.md",
    "catalog-info.yaml",
    "observability/**/*",
    "Audit/**/*"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": {
      "import": "./Config.schema.json"
    }
  },
  "keywords": [
    "redis",
    "elasticache",
    "cache",
    "aws",
    "platform",
    "component"
  ],
  "author": "Platform Engineering",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/project42/shinobi.git",
    "directory": "packages/components/elasticache-redis"
  },
  "peerDependencies": {
    "@shinobi/core": "workspace:*",
    "aws-cdk-lib": "^2.0.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "componentMetadata": {
    "type": "elasticache-redis",
    "category": "cache",
    "awsService": "ELASTICACHE",
    "capabilities": [
      "cache:redis"
    ],
    "complianceFrameworks": [
      "commercial",
      "fedramp-moderate",
      "fedramp-high"
    ],
    "stability": "production"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
