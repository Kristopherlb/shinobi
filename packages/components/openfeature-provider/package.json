{
  "name": "@shinobi/components-openfeature-provider",
  "version": "1.0.0",
  "private": true,
  "description": "OpenFeature Provider component for the Shinobi platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "Config.schema.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./Config.schema.json",
      "import": "./Config.schema.json"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "keywords": [
    "aws",
    "cdk",
    "openfeature",
    "feature-flags",
    "platform",
    "shinobi"
  ],
  "author": "Shinobi Platform Engineering",
  "dependencies": {
    "@shinobi/core": "workspace:*",
    "aws-cdk-lib": "^2.100.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "cdk-nag": "^2.28.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.100.0",
    "constructs": "^10.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}

