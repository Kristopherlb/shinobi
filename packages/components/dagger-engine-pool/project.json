{
  "name": "@shinobi/components-dagger-engine-pool",
  "sourceRoot": "packages/components/dagger-engine-pool/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc -b packages/components/dagger-engine-pool/tsconfig.build.json"
      },
      "outputs": [
        "{workspaceRoot}/dist/packages/components/dagger-engine-pool"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/components/dagger-engine-pool/tsconfig.json --noEmit"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rimraf dist/packages/components/dagger-engine-pool"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "options": {
        "config": "packages/components/dagger-engine-pool/vitest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --ext .ts,.tsx"
      }
    }
  },
  "tags": [
    "scope:shinobi",
    "type:component",
    "infra:aws"
  ]
}
