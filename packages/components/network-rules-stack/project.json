{
  "name": "@shinobi/components-network-rules-stack",
  "sourceRoot": "packages/components/network-rules-stack/src",
  "tags": [
    "scope:shinobi",
    "type:component",
    "infra:aws"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "outputPath": "dist/packages/components/network-rules-stack",
        "tsConfig": "packages/components/network-rules-stack/tsconfig.json",
        "main": "packages/components/network-rules-stack/index.ts"
      },
      "outputs": [
        "{options.outputPath}"
      ]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "config": "packages/components/network-rules-stack/vitest.config.ts",
        "passWithNoTests": true
      },
      "outputs": [
        "{projectRoot}/coverage"
      ]
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/components/network-rules-stack/**/*.ts"
        ]
      }
    },
    "type-check": {
      "executor": "@nx/js:tsc",
      "options": {
        "tsConfig": "packages/components/network-rules-stack/tsconfig.json",
        "noEmit": true
      }
    }
  }
}
