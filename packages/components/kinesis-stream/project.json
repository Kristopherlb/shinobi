{
  "name": "@shinobi/components-kinesis-stream",
  "sourceRoot": "packages/components/kinesis-stream",
  "implicitDependencies": [
    "@shinobi/core"
  ],
  "tags": [
    "scope:shinobi",
    "type:component",
    "infra:aws"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/core/tsconfig.lib.json && tsc -b packages/components/kinesis-stream/tsconfig.json",
        "cwd": "{workspaceRoot}"
      },
      "outputs": [
        "{workspaceRoot}/dist/packages/components/kinesis-stream"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "options": {
        "commands": [
          {
            "command": "vitest run --config vitest.config.ts",
            "forwardAllArgs": false
          }
        ],
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "packages/components/kinesis-stream/**/*.ts"
        ]
      }
    },
    "type-check": {
      "executor": "@nx/js:tsc",
      "options": {
        "tsConfig": "packages/components/kinesis-stream/tsconfig.json",
        "noEmit": true
      }
    }
  }
}

