{
  "name": "@shinobi/components-api-gateway-rest",
  "sourceRoot": "packages/components/api-gateway-rest",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/components/api-gateway-rest/tsconfig.json",
        "cwd": "{workspaceRoot}"
      },
      "inputs": [
        "default",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/index.ts",
        "{projectRoot}/*.ts",
        "{projectRoot}/tests/**/*.ts"
      ],
      "outputs": [
        "{workspaceRoot}/dist/packages/components/api-gateway-rest"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p packages/components/api-gateway-rest/tsconfig.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "options": {
        "commands": [
          {
            "command": "vitest run --config vitest.config.ts",
            "forwardAllArgs": false
          }
        ],
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/components/api-gateway-rest --ext .ts --no-ignore",
        "cwd": "{projectRoot}"
      }
    }
  },
  "tags": [
    "scope:shinobi",
    "type:component",
    "infra:aws"
  ]
}
