{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../../dist/packages/components/api-gateway-rest",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "tsBuildInfoFile": "../../../dist/packages/components/api-gateway-rest/tsconfig.tsbuildinfo"
  },
  "include": [
    "index.ts",
    "Config.schema.json",
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "tests/**",
    "coverage",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/vitest.config.ts",
    "**/jest.config.ts"
  ],
  "references": [
    { "path": "../../core/tsconfig.json" }
  ]
}
