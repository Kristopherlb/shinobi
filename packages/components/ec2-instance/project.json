{
  "name": "@shinobi/components-ec2-instance",
  "sourceRoot": "packages/components/ec2-instance",
  "tags": [
    "scope:shinobi",
    "type:component",
    "infra:aws"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc -b packages/components/ec2-instance/tsconfig.build.json"
      },
      "outputs": [
        "{workspaceRoot}/dist/packages/components/ec2-instance"
      ]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "packages/components/ec2-instance/jest.config.mjs",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/components/ec2-instance --ext .ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/components/ec2-instance/tsconfig.json --noEmit"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rimraf dist/packages/components/ec2-instance"
      }
    }
  }
}

