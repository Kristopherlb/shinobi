{
  "name": "@shinobi/components-ec2-instance",
  "sourceRoot": "packages/components/ec2-instance",
  "tags": [
    "scope:shinobi",
    "type:component",
    "infra:aws"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node_modules/.bin/tsc -b packages/components/ec2-instance/tsconfig.build.json",
        "cwd": "{workspaceRoot}"
      },
      "outputs": [
        "{workspaceRoot}/dist/packages/components/ec2-instance"
      ]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "config": "packages/components/ec2-instance/vitest.config.ts",
        "passWithNoTests": true
      },
      "outputs": [
        "{projectRoot}/coverage"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/components/ec2-instance --ext .ts",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/components/ec2-instance/tsconfig.json --noEmit",
        "cwd": "{workspaceRoot}"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rimraf dist/packages/components/ec2-instance",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
