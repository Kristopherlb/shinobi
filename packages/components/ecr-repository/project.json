{
  "name": "@shinobi/components-ecr-repository",
  "sourceRoot": "packages/components/ecr-repository/src",
  "tags": [
    "scope:shinobi",
    "type:component",
    "infra:aws"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/components/ecr-repository/tsconfig.json",
        "cwd": "{workspaceRoot}"
      },
      "outputs": [
        "{workspaceRoot}/dist/packages/components/ecr-repository"
      ]
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "config": "packages/components/ecr-repository/vitest.config.ts",
        "passWithNoTests": true
      },
      "outputs": [
        "{projectRoot}/coverage"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/components/ecr-repository --ext .ts",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p packages/components/ecr-repository/tsconfig.json",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
