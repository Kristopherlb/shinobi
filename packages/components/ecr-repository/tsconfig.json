{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../../../dist/packages/components/ecr-repository",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "tsBuildInfoFile": "../../../dist/packages/components/ecr-repository/tsconfig.tsbuildinfo"
  },
  "include": [
    "*.component.ts",
    "*.builder.ts",
    "*.creator.ts",
    "index.ts",
    "src/**/*",
    "Config.schema.json"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/*.test.ts",
    "**/*.spec.ts",
    "vitest.config.ts",
    "jest.config.ts",
    "tests"
  ],
  "references": [
    {
      "path": "../../core/tsconfig.json"
    }
  ]
}

