{
  "name": "@shinobi/components-sns-topic",
  "sourceRoot": "packages/components/sns-topic",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node_modules/.bin/tsc -b packages/components/sns-topic/tsconfig.build.json",
        "cwd": "{workspaceRoot}"
      },
      "outputs": [
        "{workspaceRoot}/dist/packages/components/sns-topic"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "options": {
        "commands": [
          {
            "command": "vitest run --config vitest.config.ts",
            "forwardAllArgs": false
          }
        ],
        "cwd": "{projectRoot}"
      }
    },
    "clean": {
      "executor": "nx:run-commands",
      "options": {
        "command": "rimraf dist/packages/components/sns-topic",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/components/sns-topic/tsconfig.json --noEmit",
        "cwd": "{workspaceRoot}"
      }
    }
  },
  "tags": [
    "scope:shinobi",
    "type:component",
    "infra:aws"
  ]
}
