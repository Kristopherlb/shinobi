{
  "name": "@shinobi/components-ecs-ec2-service",
  "sourceRoot": "packages/components/ecs-ec2-service/src",
  "tags": [
    "scope:shinobi",
    "type:component",
    "infra:aws"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/components/ecs-ec2-service/tsconfig.json",
        "cwd": "{workspaceRoot}"
      },
      "outputs": [
        "{workspaceRoot}/dist/packages/components/ecs-ec2-service"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "options": {
        "commands": [
          {
            "command": "vitest run --config vitest.config.ts",
            "forwardAllArgs": false
          }
        ],
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/components/ecs-ec2-service --ext .ts",
        "cwd": "{projectRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p packages/components/ecs-ec2-service/tsconfig.json",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
