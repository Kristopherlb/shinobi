{
  "name": "@shinobi/components-certificate-manager",
  "sourceRoot": "packages/components/certificate-manager",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/components/certificate-manager/tsconfig.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p packages/components/certificate-manager/tsconfig.json"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "jest.config.mjs",
        "passWithNoTests": false
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/components/certificate-manager --ext .ts --no-ignore"
      }
    }
  },
  "tags": [
    "scope:shinobi",
    "type:component",
    "infra:aws"
  ]
}
