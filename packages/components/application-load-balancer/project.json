{
  "name": "@shinobi/components-application-load-balancer",
  "sourceRoot": "packages/components/application-load-balancer",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/components/application-load-balancer/tsconfig.json"
      },
      "inputs": [
        "default",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/index.ts",
        "{projectRoot}/*.ts",
        "{projectRoot}/tests/**/*.ts"
      ],
      "outputs": [
        "{workspaceRoot}/dist/packages/components/application-load-balancer"
      ]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p packages/components/application-load-balancer/tsconfig.json"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "options": {
        "config": "packages/components/application-load-balancer/vitest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/components/application-load-balancer --ext .ts --no-ignore"
      }
    }
  },
  "tags": [
    "scope:shinobi",
    "type:component",
    "infra:aws"
  ]
}
