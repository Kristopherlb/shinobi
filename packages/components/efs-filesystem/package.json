{
  "name": "@shinobi/components-efs-filesystem",
  "version": "1.0.0",
  "private": true,
  "description": "Amazon EFS filesystem component with encryption, lifecycle management, monitoring, and FedRAMP compliance for the Shinobi platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./Config.schema.json",
      "import": "./Config.schema.json"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "Config.schema.json",
    "README.md",
    "catalog-info.yaml"
  ],
  "license": "MIT",
  "keywords": [
    "aws",
    "cdk",
    "efs",
    "filesystem",
    "storage",
    "nfs",
    "platform",
    "shinobi",
    "encryption",
    "lifecycle",
    "monitoring"
  ],
  "author": "Shinobi Platform Engineering",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/shinobi",
    "directory": "packages/components/efs-filesystem"
  },
  "bugs": {
    "url": "https://github.com/your-org/shinobi/issues"
  },
  "homepage": "https://github.com/your-org/shinobi/tree/main/packages/components/efs-filesystem#readme",
  "dependencies": {
    "@shinobi/core": "workspace:*",
    "aws-cdk-lib": "^2.100.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "cdk-nag": "^2.28.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.100.0",
    "constructs": "^10.0.0"
  },
  "scripts": {
    "lint": "eslint . --ext .ts",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "validate": "npm run lint && npm run build"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
