    "outDir": "../../../dist/packages/components/efs-filesystem",
    "rootDir": "./src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "tsBuildInfoFile": "../../../dist/packages/components/efs-filesystem/tsconfig.tsbuildinfo"
