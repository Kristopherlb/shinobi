{
  "name": "@shinobi/api",
  "root": "packages/api",
  "sourceRoot": "packages/api/src",
  "projectType": "library",
  "implicitDependencies": [],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "options": {
        "main": "src/index.ts",
        "outputPath": "dist/packages/api",
        "tsConfig": "packages/api/tsconfig.lib.json",
        "generatePackageJson": true
      },
      "outputs": ["{options.outputPath}"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p packages/api/tsconfig.json"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "config": "packages/api/vitest.config.ts",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --ext .ts,.tsx"
      }
    }
  },
  "tags": ["scope:shinobi", "type:api"]
}


