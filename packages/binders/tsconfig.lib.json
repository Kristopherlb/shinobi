{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "preserveSymlinks": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/__tests__/**"
  ],
  "references": [
    { "path": "../core/tsconfig.lib.json" }
  ]
}
