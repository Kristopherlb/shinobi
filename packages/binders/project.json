{
  "name": "@shinobi/binders",
  "root": "packages/binders",
  "sourceRoot": "packages/binders/src",
  "projectType": "library",
  "tags": ["scope:binders", "type:lib"],
  "implicitDependencies": [
    "@shinobi/core"
  ],
  "targets": {
    "build": {
  "executor": "nx:run-commands",
  "options": {
    "command": "tsc --build packages/binders/tsconfig.lib.json"
  },
  "dependsOn": [
    {
      "target": "build",
      "projects": ["@shinobi/core"]
    }
  ],
  "outputs": ["{projectRoot}/dist"]
},
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "packages/binders/jest.config.mjs",
        "passWithNoTests": true
      }
    }
  }
}

