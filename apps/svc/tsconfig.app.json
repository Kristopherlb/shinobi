{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/shinobi",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "preserveSymlinks": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "tsBuildInfoFile": "../../dist/apps/shinobi/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.stories.ts",
    "src/**/test-setup.ts",
    "**/vitest.config.ts",
    "**/jest.config.ts"
  ],
  "references": [
    {
      "path": "../../packages/core/tsconfig.json"
    },
    {
      "path": "../../packages/binders/tsconfig.json"
    }
  ]
}
