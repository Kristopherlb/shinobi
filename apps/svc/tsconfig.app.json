{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/apps/shinobi",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "preserveSymlinks": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "baseUrl": "../../",
    "paths": {
      "@shinobi/core": ["packages/core/src/index.ts"],
      "@shinobi/core/*": ["packages/core/src/*"],
      "@shinobi/binders": ["packages/binders/src/index.ts"],
      "@shinobi/binders/*": ["packages/binders/src/*"]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.stories.ts",
    "src/**/test-setup.ts"
  ],
  "references": [
    {
      "path": "../../packages/core/tsconfig.lib.json"
    },
    {
      "path": "../../packages/binders/tsconfig.lib.json"
    }
  ]
}
