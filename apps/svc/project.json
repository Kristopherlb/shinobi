{
  "name": "@shinobi/cli",
  "sourceRoot": "apps/svc/src",
  "projectType": "application",
  "tags": [
    "scope:shinobi",
    "type:app",
    "type:cli"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "tsConfig": "apps/svc/tsconfig.app.json",
        "main": "apps/svc/src/main.ts",
        "outputPath": "dist/apps/shinobi",
        "assets": [
          {
            "input": "apps/svc",
            "glob": "package.json",
            "output": "."
          }
        ]
      }
    },
    "serve": {
      "executor": "@nx/node:execute",
      "options": {
        "buildTarget": "@shinobi/cli:build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": [
        "{projectRoot}/coverage"
      ],
      "options": {
        "commands": [
          {
            "command": "vitest run --config vitest.config.ts",
            "forwardAllArgs": false
          }
        ],
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/svc/src/**/*.ts"
        ],
        "format": "stylish"
      }
    }
  }
}
