shared-workspace-lockfile=true
auto-install-peers=true
strict-peer-dependencies=false
public-hoist-pattern[]=*jest*
public-hoist-pattern[]=@jest/*
public-hoist-pattern[]=@jest/test-sequencer
public-hoist-pattern[]=@types/*
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=ts-node
public-hoist-pattern[]=esbuild
public-hoist-pattern[]=@swc/*

# Override global CodeArtifact registry - use public npm for all packages
# CodeArtifact token may be expired, so use public registry as default
registry=https://registry.npmjs.org/

# Only use CodeArtifact/Artifactory for @ninjaone scoped packages
@ninjaone:registry=https://artifactory.prod-gh-svc.ninjarmm.com/artifactory/api/npm/ninjaone-npm-prod-virtual/
